# Blue Collar Tips — local and Railway environment
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5436/bluecollartips
DATABASE_POOL_SIZE=10

APP_BASE_URL=http://localhost:3000
APP_PUBLIC_URL=http://localhost:3000
# Explicit platform super-admin allowlist (comma-separated; never first-user based)
SUPER_ADMIN_EMAILS=owner@example.com

STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1...

RESEND_API_KEY=re_...
EMAIL_FROM=Blue Collar Tips <noreply@example.com>

# SMTP alternative. EMAIL/EMAIL_PASSWORD and the legacy lowercase names are
# also accepted. Gmail, Yahoo, and Outlook hosts are inferred automatically.
SMTP_USER=mailer@example.com
SMTP_PASSWORD=use-an-app-password
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false

# Google OAuth
GOOGLE_CLIENT_ID=123456789-example.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-example
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

GHL_WEBHOOK_SECRET=
