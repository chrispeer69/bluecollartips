# Blue Collar Tips — Railway / self-host environment reference
# Copy real values from your Lovable project `.env` and Lovable Secrets.
# Do NOT commit this file with real secrets filled in.

# =============================================================================
# SUPABASE / LOVABLE CLOUD (required)
# =============================================================================
# Public config — these are already in your repo `.env`
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# Server-side admin client (bypasses RLS).
# IMPORTANT: Lovable Cloud does NOT expose the service role key.
# If Railway must run admin server functions (webhooks, refunds, invites),
# you must either:
#   1) Keep those functions running on Lovable, or
#   2) Move to your own Supabase project where you control the service role key.
SUPABASE_SERVICE_ROLE_KEY=

# Vite build-time equivalents — must be present during `bun run build`
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# =============================================================================
# STRIPE (required for card tips)
# =============================================================================
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# =============================================================================
# SMS / GO HIGH LEVEL (GHL)
# =============================================================================
# Twilio / SMS sender number (A2P verified)
TWILIO_FROM_NUMBER=

# GHL Conversations API credentials
GHL_API_KEY=
GHL_PRIVATE_API_KEY=
GHL_LOCATION_ID=

# =============================================================================
# LOVABLE INTERNAL (optional — only if using connector gateway or Lovable email)
# =============================================================================
LOVABLE_API_KEY=

# =============================================================================
# APP CONFIG (optional)
# =============================================================================
# Public root URL of the deployed app, used for absolute links/webhooks
APP_URL=https://bluecollartips.app
