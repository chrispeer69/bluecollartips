# Blue Collar Tips — local and Railway environment
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5436/bluecollartips
DATABASE_POOL_SIZE=10

APP_BASE_URL=http://localhost:3000
APP_PUBLIC_URL=http://localhost:3000
# Explicit platform super-admin allowlist (comma-separated; never first-user based)
SUPER_ADMIN_EMAILS=owner@example.com

STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Encrypts bank and manual payout instructions stored by the platform.
# Generate once with: openssl rand -base64 32
PAYOUT_DETAILS_ENCRYPTION_KEY=
# Optional during a test-to-live transition. The webhook accepts either secret.
# STRIPE_LIVE_WEBHOOK_SECRET=whsec_...
# STRIPE_TEST_WEBHOOK_SECRET=whsec_...

TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1...

RESEND_API_KEY=re_...
EMAIL_FROM=Blue Collar Tips <noreply@example.com>

# SMTP alternative. EMAIL/EMAIL_PASSWORD and the legacy lowercase names are
# also accepted. Gmail, Yahoo, and Outlook hosts are inferred automatically.
SMTP_USER=mailer@example.com
SMTP_PASSWORD=use-an-app-password
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false

# Google OAuth
GOOGLE_CLIENT_ID=123456789-example.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-example
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

GHL_WEBHOOK_SECRET=

# Where the tracked Convini link (/go/convini) sends customers. Defaults to https://convini.live
# CONVINI_APP_URL=https://convini.live

# Private review feed for a company's own website (GET /api/private/reviews/<slug>).
# Off until set. Holds ONLY the SHA-256 hex of each company's bearer token, never the token:
#   node -e "const t=require('crypto').randomBytes(32).toString('base64url');console.log('token:',t);console.log('hash: ',require('crypto').createHash('sha256').update(t).digest('hex'))"
# PRIVATE_REVIEW_FEED_TOKENS=roadside-towing:<64-hex sha256 of the token>

# Partner rating feed (US Tow Jobs / drivingjobs.online). Off until set.
# PARTNER_API_KEY=<random 32+ chars, shared with the partner>
# PARTNER_API_SLUGS=roadside-towing
# PARTNER_WEBHOOK_URL=https://drivingjobs.online/integrations/bct/webhook/
# PARTNER_WEBHOOK_SECRET=<random 32+ chars, shared with the partner>
